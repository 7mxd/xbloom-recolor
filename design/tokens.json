          "kind": "text"
        },
        {
          "fg": "color.on-action-secondary",
          "bg": "color.action-secondary",
          "kind": "text"
        },
        {
          "fg": "color.on-success",
          "bg": "color.success",
          "kind": "text"
        },
        {
          "fg": "color.on-warning",
          "bg": "color.warning",
